# Google Cloud Platform
GCP_PROJECT_ID=rescene-backend
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash
IMAGE_GENERATION_MODEL=gemini-2.0-flash-preview-image-generation

# Server
PORT=8080

# Set to "true" to use MockAIService instead of Vertex AI (no GCP credentials needed)
USE_MOCK_AI=false
