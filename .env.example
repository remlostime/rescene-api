# Cloud Provider: 'google' or 'aws'
CLOUD_PROVIDER=google

# Google Cloud Platform (required when CLOUD_PROVIDER=google)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash
GCS_BUCKET_NAME=rescene-images
IMAGE_GENERATION_MODEL=gemini-2.0-flash-preview-image-generation

# AWS (required when CLOUD_PROVIDER=aws)
AWS_REGION=us-east-1
S3_BUCKET_NAME=rescene-images
BEDROCK_NOVA_MODEL=us.amazon.nova-lite-v1:0
BEDROCK_TITAN_IMAGE_MODEL=amazon.titan-image-generator-v2:0

# Server
PORT=8080

# Set to "true" to use MockAIService instead of real AI (no cloud credentials needed)
USE_MOCK_AI=false
